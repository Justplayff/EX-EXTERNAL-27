# ZEX Injection VPS Server Configuration
# Copy this file to .env and fill in your values

# Server Port (default: 9009)
PORT=9009

# VPS Public URL (without trailing slash)
# This is the URL your iOS app will connect to
VPS_URL=http://138.249.138.78:9009

# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Admin Telegram User IDs
# Separate multiple IDs with commas
# Get your ID from @userinfobot on Telegram
ADMIN_IDS=6433997955,8046060095

# Optional: Use a different port for development
# PORT=9001
